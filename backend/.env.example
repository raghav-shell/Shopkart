PORT=5001
# Copy the Atlas driver connection string here. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/shopkart?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_strong_secret
NODE_ENV=development
# Generate these in Razorpay Dashboard with Test Mode enabled.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Optional server-only key for product creation; production creation is denied without it.
# Send this key in X-Product-Key from an API client, never from the frontend.
PRODUCT_WRITE_KEY=
